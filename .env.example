# Database (TimescaleDB / Postgres)
DB_HOST=timescaledb
DB_PORT=5432
DB_USER=iot
DB_PASSWORD=iot_password
DB_NAME=iot_backend

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MQTT broker (EMQX)
MQTT_URL=mqtt://emqx:1883

# Phase 2: จำนวนวินาทีที่ถ้าอุปกรณ์ไม่ส่งข้อมูลเข้ามาเลย จะถูก mark เป็น offline
DEVICE_OFFLINE_THRESHOLD_SECONDS=30

# Phase 3: เวลารอ ack จากอุปกรณ์ก่อนจะ mark คำสั่งเป็น timeout (มิลลิวินาที)
COMMAND_TIMEOUT_MS=10000

# Phase 5: MediaMTX (ดูสตรีมกล้อง)
# MEDIAMTX_API_URL: URL ที่ backend ใช้เรียก control API ของ MediaMTX (local dev ใช้ localhost, container ใช้ mediamtx)
MEDIAMTX_API_URL=http://mediamtx:9997
# URL ที่ browser ของผู้ใช้ใช้เปิดดูสตรีมจริง (เข้าถึงจากนอก docker network เสมอ จึงเป็น localhost เสมอ)
MEDIAMTX_PUBLIC_HLS_URL=http://localhost:8888
MEDIAMTX_PUBLIC_WEBRTC_URL=http://localhost:8889
# path ของโฟลเดอร์ recordings ตามที่ "container" มองเห็น (ใช้ตอนสั่ง MediaMTX ให้บันทึกไฟล์)
RECORDINGS_CONTAINER_PATH=/recordings
# path ของโฟลเดอร์ recordings ตามที่ "backend" มองเห็น (local dev ใช้ ./recordings, container ใช้ /recordings)
RECORDINGS_DIR=./recordings

# Phase 5: MinIO (เก็บคลิปที่บันทึกไว้)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=10

# Phase 7: Telegram notification (ปล่อยว่างไว้ได้ถ้ายังไม่ต้องการแจ้งเตือนจริง ระบบจะ log ไว้เฉยๆ ไม่ error)
# วิธีได้ token: คุยกับ @BotFather ใน Telegram พิมพ์ /newbot ตามขั้นตอน
# วิธีได้ chat_id: คุยกับบอทที่สร้างไว้ 1 ข้อความ แล้วเปิด https://api.telegram.org/bot<TOKEN>/getUpdates ดูค่า chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# เฟส F: แจ้งเตือนรายผู้ใช้ (ผู้ใช้ผูกบัญชี Telegram/LINE/อีเมลของตัวเองในแอป หน้า แจ้งเตือน > ตั้งค่า)
# Telegram: ใช้ TELEGRAM_BOT_TOKEN ข้างบน (TELEGRAM_CHAT_ID ไม่บังคับแล้ว ใช้เป็นช่องกลางที่รับทุกเหตุการณ์)
# LINE: สร้าง Messaging API channel ที่ https://developers.line.biz แล้วตั้ง Webhook URL เป็น https://<api โดเมน>/integrations/line/webhook
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_BOT_BASIC_ID=
# อีเมลผ่าน Resend: สมัคร https://resend.com ยืนยันโดเมนผู้ส่ง แล้วใส่ key
RESEND_API_KEY=
EMAIL_FROM=

# เฟส H: ท่อรับ telemetry
# direct = ประมวลผลทันทีทีละ message (ค่าเริ่มต้น, เหมาะกับเครื่องทดสอบ)
# stream = ส่งเข้าคิว Redis Streams แล้ว worker เขียน DB เป็น batch (เหมาะกับอุปกรณ์จำนวนมาก; ถ้า Redis ล่มจะ fallback เป็น direct)
INGEST_MODE=direct
INGEST_BATCH_SIZE=500
INGEST_STREAM_MAXLEN=200000

# App
PORT=3000
NODE_ENV=development
