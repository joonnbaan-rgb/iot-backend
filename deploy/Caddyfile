{
	email {$ACME_EMAIL}
}

# REST API + WebSocket (socket.io) ของ backend
{$API_DOMAIN} {
	encode gzip
	# /metrics และ /internal เป็นของภายในเครือข่าย docker ไม่เปิดสู่สาธารณะ
	@internal path /metrics* /internal*
	respond @internal 404
	reverse_proxy backend:3000
}

# Web Admin (React SPA)
{$ADMIN_DOMAIN} {
	encode gzip
	reverse_proxy webadmin:80
}

# Grafana (ต้องล็อกอินด้วยรหัส admin ใน deploy/.env.prod -> GRAFANA_ADMIN_PASSWORD)
{$GRAFANA_DOMAIN} {
	encode gzip
	reverse_proxy grafana:3000
}

# สตรีมกล้อง (HLS) — ต้องมีโทเคนอายุจำกัดใน path: /s/{token}/{deviceId}/index.m3u8
# ทุกคำขอ (playlist และ segment) ถูกส่งไปตรวจที่ backend ก่อน (route = ทำตามลำดับที่เขียน)
{$STREAM_DOMAIN} {
	@hls path_regexp hls ^/s/[^/]+/(.*)$
	route @hls {
		forward_auth backend:3000 {
			uri /internal/stream-auth
		}
		rewrite * /{re.hls.1}
		reverse_proxy mediamtx:8888
	}
	respond 404
}

# โดเมนนี้มีไว้ให้ Caddy ขอใบรับรองให้ MQTT (EMQX ใช้ใบรับรองนี้ที่พอร์ต 8883)
{$MQTT_DOMAIN} {
	respond "mqtt over tls: port 8883" 200
}
